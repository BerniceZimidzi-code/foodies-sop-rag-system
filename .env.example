# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-4
AZURE_OPENAI_DEPLOYMENT=foodies-sop-assistant

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/foodies_sop

# Authentication
SECRET_KEY=your_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://foodies-sop.example.com

# Environment
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Vector Store
PINECONE_API_KEY=your_pinecone_key
PINECONE_ENVIRONMENT=us-east1-gcp
PINECONE_INDEX=foodies-sop

# Audit Log
AUDIT_LOG_TABLE=audit_logs
AUDIT_LOG_RETENTION_DAYS=90
