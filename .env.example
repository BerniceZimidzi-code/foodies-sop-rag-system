# Copy this file to .env. Do not commit .env or share its contents.
FOODIES_JWT_SECRET=

# Optional: set all four only to bootstrap the first admin on an empty database.
# Keep these as deployment secrets if ephemeral storage may reset the database.
FOODIES_BOOTSTRAP_ADMIN_EMAIL=
FOODIES_BOOTSTRAP_ADMIN_NAME=
FOODIES_BOOTSTRAP_ADMIN_DEPARTMENT=
FOODIES_BOOTSTRAP_ADMIN_PASSWORD=

# Gmail SMTP settings for the SENDING account (not recipient accounts).
FOODIES_SMTP_HOST=smtp.gmail.com
FOODIES_SMTP_PORT=587
FOODIES_SMTP_SECURITY=starttls
FOODIES_SMTP_USERNAME=
FOODIES_SMTP_PASSWORD=
FOODIES_EMAIL_FROM=

# Local test URL. Use the deployed HTTPS URL outside local development.
FOODIES_BASE_URL=http://127.0.0.1:8128

# Select extractive, ollama, openai, or openrouter.
FOODIES_LLM_PROVIDER=extractive

# Local Ollama model for testing; Ollama must be running on this computer.
FOODIES_OLLAMA_BASE_URL=http://127.0.0.1:11434
FOODIES_OLLAMA_MODEL=qwen2.5:3b

# Optional hosted OpenAI provider.
OPENAI_API_KEY=
FOODIES_OPENAI_MODEL=gpt-4.1-mini

# Optional OpenRouter provider, including the free-model router.
OPENROUTER_API_KEY=
FOODIES_OPENROUTER_MODEL=openrouter/free
