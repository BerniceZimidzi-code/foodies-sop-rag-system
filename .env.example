# Copy this file to .env. Do not commit .env or share its contents.
FOODIES_JWT_SECRET=

# Gmail SMTP settings for the SENDING account (not recipient accounts).
FOODIES_SMTP_HOST=smtp.gmail.com
FOODIES_SMTP_PORT=587
FOODIES_SMTP_SECURITY=starttls
FOODIES_SMTP_USERNAME=
FOODIES_SMTP_PASSWORD=
FOODIES_EMAIL_FROM=

# Local test URL. Use the deployed HTTPS URL outside local development.
FOODIES_BASE_URL=http://127.0.0.1:8127

# Local Ollama model for testing; Ollama must be running on this computer.
FOODIES_LLM_PROVIDER=ollama
FOODIES_OLLAMA_BASE_URL=http://127.0.0.1:11434
FOODIES_OLLAMA_MODEL=qwen2.5:3b

# Optional hosted OpenAI provider for later deployment.
OPENAI_API_KEY=
FOODIES_OPENAI_MODEL=gpt-4.1-mini
